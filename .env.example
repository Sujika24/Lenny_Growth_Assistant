# ========================================================
# THE LENNY GROWTH ASSISTANT - ENVIRONMENT CONFIGURATION
# ========================================================

# Application Mode
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL primary, automatic SQLite fallback for local dev)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lenny_growth
# For local development without PostgreSQL, leave DATABASE_URL blank or use sqlite:///./lenny_growth.db
SQLITE_FALLBACK_URL=sqlite:///./lenny_growth.db

# Knowledge Base & Vector Store
TRANSCRIPTS_DATA_DIR=data/lenny_repo/episodes
CHROMA_PERSIST_DIR=data/chroma_db
RETRIEVAL_TOP_K=4
RETRIEVAL_SIMILARITY_THRESHOLD=0.35

# Local Model Provider (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=90

# Cloud Model Providers (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Default Selected Provider ('ollama' or 'anthropic' or 'openai')
DEFAULT_PROVIDER=ollama
